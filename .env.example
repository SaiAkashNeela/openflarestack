# Environment for running the scripts locally. Nothing loads this file automatically:
# copy it to .env (git-ignored) and run e.g. `node --env-file=.env scripts/daily.js`.
# In GitHub Actions these come from repository secrets and variables (see README "Setup").

# --- Nightly pipeline (npm run catalog:daily) ---
# GitHub token for code search, REST and GraphQL. Fine-grained PAT with public read only.
# Falls back to GITHUB_TOKEN, then GH_TOKEN.
GH_SEARCH_TOKEN=
GITHUB_TOKEN=
GH_TOKEN=
# Optional LLM classifier: any OpenAI-compatible chat completions endpoint.
# Without both of these, awesome-list entries use the list's own hints and the rest wait in data/review.md.
LLM_BASE_URL=
LLM_API_KEY=
# Default: openrouter/free on OpenRouter, otherwise @cf/meta/llama-3.3-70b-instruct-fp8-fast
LLM_MODEL=
# Defaults: 2 parallel requests, 40 classifications per run, 3500 ms between requests.
LLM_CONCURRENCY=2
LLM_MAX_PER_RUN=40
LLM_MIN_INTERVAL_MS=3500
# Repos with fewer stars are filtered out. Default 3.
MIN_STARS=3
# Where the awesome-cloudflare-selfhosted sparse clone lives. Default: a folder in the OS temp dir.
AWESOME_DIR=
# Optional: save every README read during the run into this folder.
README_DUMP=

# --- Submission bot (npm run catalog:submission) ---
# Set by GitHub Actions; only needed to run scripts/submission.js by hand.
GITHUB_EVENT_PATH=
GITHUB_REPOSITORY=
GITHUB_OUTPUT=

# --- Site build (npm run build) ---
# All optional. Defaults: data/catalog.json, dist/, avatars downloaded from GitHub.
# OUT_DIR is deleted and rewritten, so the build refuses any folder that contains the repo.
CATALOG_FILE=
OUT_DIR=
# 1 = don't download owner avatars (offline builds and tests); pages show letter tiles instead.
SKIP_AVATARS=

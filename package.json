{
  "name": "openflarestack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:worker": "npm run dev --prefix worker",
    "dev:ui": "npm run dev --prefix new-ui",
    "build": "npm run build --prefix new-ui",
    "type-check": "npm run type-check --prefix worker",
    "deploy": "npm run build && npm run deploy --prefix worker",
    "db:migrate": "npm run db:migrate --prefix worker",
    "db:migrate:local": "npm run db:migrate:local --prefix worker"
  }
}
